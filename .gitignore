# =====================================================================================
# .gitignore — Glob-Gusters Video-Club
# Excluye del control de versiones lo que se genera localmente o contiene datos
# privados. Los scripts .sql, el código fuente, requirements.txt y .env.example SÍ
# se versionan.
# =====================================================================================

# -------------------------------------------------------------------------------------
# Configuración local y secretos
# -------------------------------------------------------------------------------------
# Variables reales de conexión (contraseñas). La plantilla .env.example sí se versiona.
.env
.env.*
!.env.example

# -------------------------------------------------------------------------------------
# Registros de ejecución
# -------------------------------------------------------------------------------------
*.log
/logs/

# -------------------------------------------------------------------------------------
# SQL / MariaDB / MySQL / XAMPP / Oracle
# -------------------------------------------------------------------------------------
# Archivos de datos que genera el propio servidor (XAMPP).
*.ibd
*.frm
*.err
*.pid
ib_logfile*
ibdata*
# Historial de comandos de los clientes de consola.
.mysql_history
.mariadb_history
.sqlplus_history
# Volcados y respaldos locales (el esquema oficial vive en sql/, no en un dump).
*.dump
*.sql.gz
*.sql.zip
*.sql.bak
# Resultados temporales de herramientas de Oracle (SQL*Plus, trazas).
*.lst
*.trc
# MySQL Workbench
*.mwb.bak
*.mwbhistory/

# -------------------------------------------------------------------------------------
# Python
# -------------------------------------------------------------------------------------
# Entorno virtual (se recrea con `python3 -m venv .venv && pip install -r requirements.txt`).
.venv/
venv/
env/
# Código compilado y cachés.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
htmlcov/
# Empaquetado y compilación.
build/
dist/
*.egg-info/
*.egg
pip-log.txt
pip-delete-this-directory.txt
# Jupyter
.ipynb_checkpoints/

# -------------------------------------------------------------------------------------
# Java
# -------------------------------------------------------------------------------------
# Compilación (las clases se generan con `javac -d out`).
java/out/
java/bin/
java/target/
java/build/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
# Dependencias descargables (driver JDBC; ver README).
java/lib/
# Maven / Gradle
.gradle/
.mvn/wrapper/maven-wrapper.jar
# Configuración de IDE (IntelliJ IDEA, Eclipse, NetBeans)
.idea/
*.iml
.classpath
.project
.settings/
.factorypath
nbproject/

# -------------------------------------------------------------------------------------
# Editores
# -------------------------------------------------------------------------------------
.vscode/
*.code-workspace

# -------------------------------------------------------------------------------------
# Sistema operativo y temporales
# -------------------------------------------------------------------------------------
Thumbs.db
.DS_Store
*.bak
*.tmp
*.swp
