# =====================================================================================
# .env.example — ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (PLANTILLA)
# =====================================================================================
# Este archivo es una PLANTILLA de ejemplo: muestra qué variables de entorno usa el
# proyecto y cuáles son sus valores por defecto. NO contiene datos reales ni secretos
# y SÍ se versiona en Git para que cualquier persona sepa qué debe configurar.
#
# CÓMO USARLO:
#   1. Copia esta plantilla a un archivo nuevo llamado `.env` en la raíz del proyecto:
#          cp .env.example .env            (macOS / Linux)
#          copy .env.example .env          (Windows, cmd.exe)
#   2. Edita `.env` con los valores de TU servidor (sobre todo GLOB_GUSTERS_PASSWORD).
#   3. No edites ni subas credenciales reales en este archivo de ejemplo.
#
# QUIÉN LO LEE:
#   - Python: py/conexion.py  (función _cargar_env)
#   - Java:   java/Conexion.java (método cargarEnv; busca `.env` en el directorio actual
#             y en su padre, así que funciona ejecutando desde la raíz o desde java/)
#
# REGLAS DE FORMATO:
#   - Una variable por línea, con la forma CLAVE=valor (sin espacios alrededor del `=`
#     es lo recomendado).
#   - Las líneas vacías y las que empiezan con `#` se ignoran.
#   - Se admiten comillas simples o dobles alrededor del valor y el prefijo `export `.
#   - Un valor vacío (CLAVE=) es válido: significa "sin contraseña" en el caso de
#     GLOB_GUSTERS_PASSWORD.
#
# PRIORIDAD DE LOS VALORES (de mayor a menor):
#   1. Variable ya definida en el sistema (p. ej. `export GLOB_GUSTERS_PORT=3307`).
#   2. Valor escrito en el archivo `.env`.
#   3. Valor por defecto del código (los mismos que aparecen abajo, propios de XAMPP).
# =====================================================================================


# -------------------------------------------------------------------------------------
# CONEXIÓN AL SERVIDOR MARIADB
# -------------------------------------------------------------------------------------

# Servidor donde corre MariaDB. En XAMPP local es la propia máquina.
GLOB_GUSTERS_HOST=localhost

# Puerto TCP de MariaDB. XAMPP usa 3306 por defecto; cámbialo solo si otro servicio
# lo ocupa y moviste MariaDB a otro puerto (p. ej. 3307).
GLOB_GUSTERS_PORT=3306

# Usuario con el que se abre la conexión. `root` es el administrador de XAMPP; lo
# necesita dcl.py / Dcl.java para crear usuarios y conceder permisos.
GLOB_GUSTERS_USER=root

# Contraseña del usuario anterior. XAMPP instala `root` SIN contraseña, por eso aquí
# queda vacía. Si tu servidor sí la exige, escríbela tras el `=` en tu `.env`
# (nunca en este archivo de ejemplo). Si falta o es incorrecta, los programas
# muestran el error 1045 (acceso denegado) con un mensaje que apunta a esta variable.
GLOB_GUSTERS_PASSWORD=

# Base de datos a la que se conecta. Debe existir: se crea ejecutando
# sql/mariadb/glob_gusters.sql (si no existe, los programas muestran el error 1049).
GLOB_GUSTERS_DB=glob_gusters


# -------------------------------------------------------------------------------------
# CONTRASEÑAS DE LAS CUENTAS DE EJEMPLO (solo las usan dcl.py y Dcl.java)
# -------------------------------------------------------------------------------------
# Son las contraseñas con las que se CREAN las cuentas glob_gusters_reportes y
# glob_gusters_mostrador. Los valores de abajo son los mismos de sql/mariadb/commands/
# 05_DCL.sql y sirven solo para práctica: cámbialos en cualquier uso real.

# Cuenta de solo lectura (únicamente SELECT sobre glob_gusters).
GLOB_GUSTERS_PASS_REPORTES=Reportes#2024

# Cuenta de mostrador (SELECT, INSERT y UPDATE; el DELETE se revoca para proteger el
# historial de rentas).
GLOB_GUSTERS_PASS_MOSTRADOR=Mostrador#2024
