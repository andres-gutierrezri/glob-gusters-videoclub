# Plantilla de configuración. Copia este archivo como .env y ajusta los valores:
#     cp .env.example .env
# El archivo .env real NO se versiona (.gitignore); esta plantilla sí.

GLOB_GUSTERS_HOST=localhost
GLOB_GUSTERS_PORT=3306
GLOB_GUSTERS_USER=root
GLOB_GUSTERS_PASSWORD=
GLOB_GUSTERS_DB=glob_gusters

# Contraseñas de las cuentas de ejemplo que crean dcl.py y Dcl.java.
GLOB_GUSTERS_PASS_REPORTES=Reportes#2024
GLOB_GUSTERS_PASS_MOSTRADOR=Mostrador#2024
